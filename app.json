{
  "expo": {
    "name": "Rise for Tahajjud",
    "slug": "rise-for-tahajjud",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#050508"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.risefortahajjud.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Rise for Tahajjud uses your location to calculate the correct local Fajr time."
      }
    },
    "android": {
      "package": "com.risefortahajjud.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "plugins": [
      "expo-notifications",
      "expo-location"
    ]
  }
}
