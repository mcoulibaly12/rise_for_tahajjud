{
  "name": "rise-for-tahajjud",
  "version": "2.1.1",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:17": "expo run:ios --device 'iPhone 17 Pro Max'",
    "ios:sim": "node scripts/run-ios-sim.mjs",
    "ios:debug-analytics": "xcrun simctl boot 'iPhone 16 Pro Max' || true && open -a Simulator && xcrun simctl spawn booted launchctl setenv FIREBASE_ANALYTICS_DEBUG_MODE 1 && LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 npx expo run:ios",
    "ios:build:production": "eas build -p ios --profile production",
    "ios:submit:production": "eas submit -p ios --profile production",
    "web": "expo start --web",
    "lint": "expo lint"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.1",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/playfair-display": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/slider": "4.5.6",
    "@react-native-firebase/analytics": "^24.0.0",
    "@react-native-firebase/app": "^24.0.0",
    "adhan": "^4.4.3",
    "date-fns": "^4.1.0",
    "expo": "~53.0.0",
    "expo-blur": "~14.1.3",
    "expo-build-properties": "^55.0.10",
    "expo-constants": "~17.1.8",
    "expo-dev-client": "~5.2.4",
    "expo-font": "~13.3.1",
    "expo-haptics": "~14.1.4",
    "expo-linear-gradient": "~14.1.3",
    "expo-localization": "^55.0.9",
    "expo-location": "~18.1.6",
    "expo-notifications": "~0.31.4",
    "expo-status-bar": "~2.2.3",
    "lucide-react-native": "^0.475.0",
    "moti": "^0.30.0",
    "react": "19.0.0",
    "react-native": "0.79.6",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.0.10",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~9.2.0",
    "typescript": "~5.8.3"
  }
}
